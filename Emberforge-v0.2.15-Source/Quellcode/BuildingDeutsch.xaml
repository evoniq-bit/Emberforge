<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:System;assembly=mscorlib">
 <s:String x:Key="buildTitle">Dein Material. Deine Bauwerke.</s:String>
 <s:String x:Key="buildIntro">Material anvisieren, als Ersatz merken und mit dem Bauhammer platzieren.</s:String>
 <s:String x:Key="buildReadTitle">Mit der Spitzhacke als Material übernehmen</s:String>
 <s:String x:Key="buildReadHint">Spitzhacke nehmen → Boden oder Baublock im Fadenkreuz anvisieren → deinen Übernehmen-Hotkey drücken. Dein Ziel wird sofort als Ersatz aktiviert.</s:String>
 <s:String x:Key="buildRead">Material im Fadenkreuz merken</s:String>
 <s:String x:Key="buildIdLabel">Material-ID (1–255)</s:String>
 <s:String x:Key="buildReplaceTitle">Material überschreiben</s:String>
 <s:String x:Key="buildReplaceHint">Bei aktiviertem Ersetzen wird das Baumaterial, das du mit dem Bauhammer platzierst, durch deine Auswahl ersetzt.</s:String>
 <s:String x:Key="buildApply">Auswahl übernehmen</s:String>
 <s:String x:Key="buildFavoriteName">Name für deinen Favoriten</s:String>
 <s:String x:Key="buildFavorites">Deine Materialfavoriten</s:String>
 <s:String x:Key="buildSaveFavorite">Als Favorit speichern</s:String>
 <s:String x:Key="buildRemoveFavorite">Favorit entfernen</s:String>
 <s:String x:Key="buildUseFavorite">Favorit übernehmen</s:String>
 <s:String x:Key="objectTitle">Eine Welt voller Möglichkeiten.</s:String>
 <s:String x:Key="objectIntro">Zäune, Türen, Pflanzen und Dekoration erfassen und als neue Objekte platzieren.</s:String>
 <s:String x:Key="objectAimTitle">Mit der Spitzhacke als Objekt übernehmen</s:String>
 <s:String x:Key="objectAimHint">Spitzhacke nehmen → Objekt im Fadenkreuz anvisieren → deinen Übernehmen-Hotkey drücken. Dein Ziel wird sofort als Ersatz aktiviert. Anschließend dein Ausgangsobjekt platzieren.</s:String>
 <s:String x:Key="objectRemember">Objekt im Fadenkreuz merken</s:String>
 <s:String x:Key="objectUseAim">Gemerktes Objekt als Ersatz</s:String>
 <s:String x:Key="objectCatalogTitle">Objektkatalog</s:String>
 <s:String x:Key="objectSearchHint">Katalog durchsuchen</s:String>
 <s:String x:Key="objectOnlyFavorites">Nur Favoriten</s:String>
 <s:String x:Key="objectUseSelected">Auswahl als Ersatz</s:String>
 <s:String x:Key="objectFavorite">Favorit umschalten</s:String>
 <s:String x:Key="objectSourceTitle">Ausgangsobjekt</s:String>
 <s:String x:Key="objectImport">Katalog aus Spieldateien aktualisieren</s:String>
 <s:String x:Key="objectTechnical">Auch Kreaturen, Effekte und technische Vorlagen zeigen</s:String>
 <s:String x:Key="objectAnySource">Aktuell ausgewähltes platzierbares Objekt</s:String>
 <s:String x:Key="objectFixedSource">Fest gewähltes Ausgangsobjekt</s:String>
 <s:String x:Key="objectUseSelectedSource">Katalogauswahl als feste Quelle</s:String>
 <s:String x:Key="objectCaptureSource">Zuletzt normal platziertes Objekt als Quelle</s:String>
 <s:String x:Key="objectSourceHint">Für eine feste Quelle kannst du beispielsweise eine Werkbank oder Vase wählen. Für das Erfassen einer neuen Quelle Ersetzen ausschalten und sie einmal normal platzieren.</s:String>
 <s:String x:Key="objectReplaceTitle">Objekt überschreiben</s:String>
 <s:String x:Key="objectReplaceHint">Dein Ausgangsobjekt wird beim Platzieren durch diesen Ersatz ersetzt. Der Abwählen-Hotkey schaltet Ersetzen aus.</s:String>
 <s:String x:Key="buildingConnect">Mit Enshrouded verbinden</s:String>
 <s:String x:Key="buildingDisconnected">Zum Erfassen und Ersetzen zuerst mit Enshrouded verbinden.</s:String>
 <s:String x:Key="buildingWaiting">Warte auf ein Ziel im Spiel …</s:String>
 <s:String x:Key="buildingNoTarget">Noch keine Auswahl</s:String>
 <s:String x:Key="buildingOn">ERSETZEN AN</s:String>
 <s:String x:Key="buildingOff">ERSETZEN AUS</s:String>
 <s:String x:Key="buildingSourceAny">Quelle: deine aktuelle Auswahl im Spiel</s:String>
 <s:String x:Key="buildPreserveTitle">Baumaterial nicht verbrauchen</s:String>
 <s:String x:Key="buildPreserveHint">Beim Platzieren von Baublöcken und Objekten bleiben deine Materialien erhalten. Die normale Materialprüfung im Baumenü bleibt aktiv. Beim späteren Abbau kann das Spiel Material zurückgeben. Erste Testversion für deine lokale Welt.</s:String>
 <s:String x:Key="buildPreserveOn">MATERIAL ERHALTEN AN</s:String>
 <s:String x:Key="buildPreserveOff">MATERIAL ERHALTEN AUS</s:String>
 <s:String x:Key="buildFreeTitle">Freies Bauen</s:String>
 <s:String x:Key="buildFreeHint">Die Materialprüfung beim Platzieren wird für Baublöcke und platzierbare Objekte übergangen. Die normale Ersetzen-Funktion bleibt unabhängig davon steuerbar. Erste Testversion für deine lokale Welt.</s:String>
 <s:String x:Key="buildFreeOn">FREIES BAUEN AN</s:String>
 <s:String x:Key="buildFreeOff">FREIES BAUEN AUS</s:String>
 <s:String x:Key="craftTitle">Deine Werkstatt. Deine Vorräte.</s:String>
 <s:String x:Key="craftIntro">Handwerk und Rezepte beim Schmied und anderen NPCs.</s:String>
 <s:String x:Key="craftFavorite">Als Favorit merken</s:String>
 <s:String x:Key="craftPreserveTitle">Zutaten nicht verbrauchen</s:String>
 <s:String x:Key="craftPreserveHint">Stelle verfügbare Rezepte her und behalte deine Zutaten. Die benötigten Materialien müssen im Herstellungsmenü vorhanden sein. Erste Testversion für Handwerk und NPC-Rezepte.</s:String>
 <s:String x:Key="craftPreserveOn">ZUTATEN ERHALTEN AN</s:String>
 <s:String x:Key="craftPreserveOff">ZUTATEN ERHALTEN AUS</s:String>
 <s:String x:Key="craftTestHint">Zum Testen ein Rezept herstellen: Zutaten sollen gleich bleiben, das fertige Item soll hinzukommen. Ausschalten und normalen Verbrauch vergleichen.</s:String>
 <s:String x:Key="craftNextTitle">Als Nächstes geplant</s:String>
 <s:String x:Key="craftNextHint">Herstellen ohne vorhandene Zutaten, alle Rezepte freischalten und einstellbare Produktionsgeschwindigkeit. Ofen, Trockner und ähnliche Stationen werden noch getrennt geprüft.</s:String>
 <s:String x:Key="objectReplacementLabel">Aktiver Ersatz</s:String>
 <s:String x:Key="nearbyTitle">Objekte in deiner Nähe</s:String>
 <s:String x:Key="nearbyHint">Scannt geladene Objekte und filtert sie nach ihrer Entfernung zu dir. Der Radius kann vor jedem Scan geändert werden.</s:String>
 <s:String x:Key="nearbyRadiusLabel">Radius (m)</s:String>
 <s:String x:Key="nearbyScan">In der Nähe scannen</s:String>
 <s:String x:Key="nearbyEmpty">Noch kein Scan</s:String>
 <s:String x:Key="nearbyLoading">Objekte werden gelesen …</s:String>
 <s:String x:Key="nearbyUse">Auswahl als Ersatz aktivieren</s:String>
 <s:String x:Key="nearbyChoose">Zuerst ein Objekt aus dem Umgebungsscan wählen.</s:String>
 <s:String x:Key="nearbyCount">verschiedene Objektvorlagen im geladenen Umfeld</s:String>
 <s:String x:Key="nearbyReady">Umgebung gelesen. Wähle ein Objekt und aktiviere es als Ersatz.</s:String>
 <s:String x:Key="equipmentTitle">Deine Ausrüstung. Für jedes Abenteuer.</s:String>
 <s:String x:Key="equipmentIntro">Werkzeuge und Waffen erhalten; weitere Inventarfunktionen folgen.</s:String>
 <s:String x:Key="durabilityTitle">Unendliche Haltbarkeit</s:String>
 <s:String x:Key="durabilityHint">Waffen und Werkzeuge verlieren beim Benutzen keine Haltbarkeit. Bereits beschädigte oder kaputte Gegenstände werden dadurch nicht repariert; normale Reparaturen bleiben möglich. Erste Testversion.</s:String>
 <s:String x:Key="durabilityOn">HALTBARKEIT ERHALTEN AN</s:String>
 <s:String x:Key="durabilityOff">HALTBARKEIT ERHALTEN AUS</s:String>
 <s:String x:Key="durabilityTestHint">Zum Testen mit einem Werkzeug abbauen und mit einer Waffe angreifen. Haltbarkeit vorher und nachher vergleichen; anschließend ausschalten und normalen Verschleiß prüfen.</s:String>
<s:String x:Key="dismantleTitle">Ersetzte Objekte normal abbauen · Test</s:String>
<s:String x:Key="dismantleHint">Vor dem Platzieren einschalten. Soll neu per Objekt-Ersetzung gesetzte Zäune, Türen und andere Weltobjekte normal rückbaubar machen. Gilt nur für das gewählte Ersatzobjekt. Vorhandene Objekte bleiben unverändert. Rückgabe von Materialien und Verhalten im Spiel müssen noch geprüft werden.</s:String>
</ResourceDictionary>
