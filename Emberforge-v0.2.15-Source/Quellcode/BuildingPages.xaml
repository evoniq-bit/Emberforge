<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="#E8E5DC">
 <UserControl.Resources>
  <DataTemplate x:Key="BuildWrappedText"><TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/></DataTemplate>
  <Style x:Key="BuildPanel" TargetType="Border"><Setter Property="Background" Value="#131E24"/><Setter Property="BorderBrush" Value="#2B3B43"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
  <Style x:Key="BuildHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#E8B778"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style x:Key="BuildHint" TargetType="TextBlock"><Setter Property="Foreground" Value="#91A2A8"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0E171C"/><Setter Property="Foreground" Value="#E8E5DC"/><Setter Property="BorderBrush" Value="#34484F"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="CaretBrush" Value="#E8B778"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#0E171C"/><Setter Property="Foreground" Value="#DBE3E3"/><Setter Property="BorderBrush" Value="#34484F"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/><Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/><Setter Property="Padding" Value="5"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="5"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#3A3026"/><Setter Property="Foreground" Value="#F4D9B5"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#23333A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </UserControl.Resources>
 <Grid>
  <StackPanel x:Name="BlocksPage" Margin="0,0,10,0">
   <TextBlock Text="{DynamicResource buildTitle}" FontFamily="Georgia" FontSize="28" Margin="0,0,0,8"/>
   <TextBlock Text="{DynamicResource buildIntro}" Style="{StaticResource BuildHint}"/>
   <Button ContentTemplate="{StaticResource BuildWrappedText}" x:Name="BlocksConnect" Content="{DynamicResource buildingConnect}" HorizontalAlignment="Left" Margin="0,0,0,14"/>
   <TextBlock x:Name="MaterialHotkeys" Visibility="Collapsed"/>
   <Border Style="{StaticResource BuildPanel}"><StackPanel>
    <TextBlock Text="{DynamicResource buildPreserveTitle}" Style="{StaticResource BuildHeading}"/>
    <TextBlock Text="{DynamicResource buildPreserveHint}" Style="{StaticResource BuildHint}"/>
    <DockPanel><TextBlock x:Name="PreserveState" Text="{DynamicResource buildingOff}" Foreground="#91A2A8" VerticalAlignment="Center"/><ToggleButton x:Name="PreserveToggle" Style="{DynamicResource Toggle}" HorizontalAlignment="Right"/></DockPanel>
   </StackPanel></Border>
   <Border Style="{StaticResource BuildPanel}"><StackPanel>
    <TextBlock Text="{DynamicResource buildFreeTitle}" Style="{StaticResource BuildHeading}"/>
    <TextBlock Text="{DynamicResource buildFreeHint}" Style="{StaticResource BuildHint}"/>
    <DockPanel><TextBlock x:Name="FreeBuildState" Text="{DynamicResource buildFreeOff}" Foreground="#91A2A8" VerticalAlignment="Center"/><ToggleButton x:Name="FreeBuildToggle" Style="{DynamicResource Toggle}" HorizontalAlignment="Right"/></DockPanel>
   </StackPanel></Border>
   <UniformGrid Columns="2">
    <StackPanel Margin="0,0,8,0">
     <Border x:Name="UnifiedMaterialCapture" Style="{StaticResource BuildPanel}"><StackPanel>
      <TextBlock Text="{DynamicResource buildReadTitle}" Style="{StaticResource BuildHeading}"/>
      <TextBlock Text="{DynamicResource buildReadHint}" Style="{StaticResource BuildHint}"/>
      <TextBlock x:Name="MaterialAim" Text="{DynamicResource buildingWaiting}" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <StackPanel x:Name="MaterialHotkeyPanel"/>
     </StackPanel></Border>
     <Border Style="{StaticResource BuildPanel}"><StackPanel>
      <TextBlock Text="{DynamicResource buildReplaceTitle}" Style="{StaticResource BuildHeading}"/>
      <TextBlock Text="{DynamicResource buildReplaceHint}" Style="{StaticResource BuildHint}"/>
      <TextBlock Text="{DynamicResource buildIdLabel}"/>
      <TextBox x:Name="MaterialId" MaxLength="3"/>
      <Button ContentTemplate="{StaticResource BuildWrappedText}" x:Name="ApplyMaterial" Content="{DynamicResource buildApply}" Margin="0,0,0,12"/>
      <DockPanel><TextBlock x:Name="BlockState" Text="{DynamicResource buildingOff}" Foreground="#91A2A8" VerticalAlignment="Center"/><ToggleButton x:Name="BlockToggle" Style="{DynamicResource Toggle}" HorizontalAlignment="Right"/></DockPanel>
     </StackPanel></Border>
    </StackPanel>
    <Border Style="{StaticResource BuildPanel}" Margin="8,0,0,14"><StackPanel>
     <TextBlock Text="{DynamicResource buildFavorites}" Style="{StaticResource BuildHeading}"/>
     <TextBlock Text="{DynamicResource buildFavoriteName}" Foreground="#91A2A8"/>
     <TextBox x:Name="MaterialFavoriteName"/>
     <Button ContentTemplate="{StaticResource BuildWrappedText}" x:Name="SaveMaterialFavorite" Content="{DynamicResource buildSaveFavorite}" Margin="0,0,0,12"/>
     <ListBox x:Name="MaterialFavorites" Height="200" Margin="0,0,0,12"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></ListBox.ItemTemplate></ListBox>
     <Button ContentTemplate="{StaticResource BuildWrappedText}" x:Name="UseMaterialFavorite" Content="{DynamicResource buildUseFavorite}" Margin="0,0,0,8"/>
     <Button ContentTemplate="{StaticResource BuildWrappedText}" x:Name="RemoveMaterialFavorite" Content="{DynamicResource buildRemoveFavorite}"/>
    </StackPanel></Border>
   </UniformGrid>
   <TextBlock x:Name="BlockStatus" Foreground="#E8B778" TextWrapping="Wrap" Margin="0,4,0,12"/>
  </StackPanel>
  <StackPanel x:Name="ObjectsPage" Margin="0,0,10,0" Visibility="Collapsed">
   <TextBlock Text="{DynamicResource objectTitle}" FontFamily="Georgia" FontSize="28" Margin="0,0,0,8"/>
   <TextBlock Text="{DynamicResource objectIntro}" Style="{StaticResource BuildHint}"/>
   <Button ContentTemplate="{StaticResource BuildWrappedText}" x:Name="ObjectsConnect" Content="{DynamicResource buildingConnect}" HorizontalAlignment="Left" Margin="0,0,0,14"/>
   <TextBlock x:Name="ObjectHotkeys" Visibility="Collapsed"/>
   <Border Style="{StaticResource BuildPanel}"><StackPanel><TextBlock Text="{DynamicResource dismantleTitle}" Style="{StaticResource BuildHeading}"/><TextBlock Text="{DynamicResource dismantleHint}" Style="{StaticResource BuildHint}"/><DockPanel><TextBlock x:Name="DismantleState" Foreground="#91A2A8" VerticalAlignment="Center"/><ToggleButton x:Name="DismantleToggle" Style="{DynamicResource Toggle}" HorizontalAlignment="Right" IsEnabled="False"/></DockPanel></StackPanel></Border>
   <UniformGrid Columns="2">
    <StackPanel Margin="0,0,8,0">
     <Border x:Name="UnifiedObjectCapture" Style="{StaticResource BuildPanel}"><StackPanel>
      <TextBlock Text="{DynamicResource objectAimTitle}" Style="{StaticResource BuildHeading}"/>
      <TextBlock Text="{DynamicResource objectAimHint}" Style="{StaticResource BuildHint}"/>
      <TextBlock x:Name="ObjectAim" Text="{DynamicResource buildingWaiting}" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <StackPanel x:Name="ObjectHotkeyPanel"/>
      <Border Height="1" Background="#2B3B43" Margin="0,10,0,16"/>
      <TextBlock Text="{DynamicResource objectReplacementLabel}" Foreground="#91A2A8" Margin="0,0,0,8"/>
      <TextBlock x:Name="ObjectReplacement" Text="{DynamicResource buildingNoTarget}" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <TextBlock Text="{DynamicResource objectReplaceHint}" Style="{StaticResource BuildHint}"/>
      <DockPanel><TextBlock x:Name="PropState" Text="{DynamicResource buildingOff}" Foreground="#91A2A8" VerticalAlignment="Center"/><ToggleButton x:Name="PropToggle" Style="{DynamicResource Toggle}" HorizontalAlignment="Right"/></DockPanel>
     </StackPanel></Border>
     <Border Style="{StaticResource BuildPanel}"><StackPanel>
      <TextBlock Text="{DynamicResource objectSourceTitle}" Style="{StaticResource BuildHeading}"/>
      <RadioButton x:Name="AnySource" Content="{DynamicResource objectAnySource}" GroupName="PropSource" IsChecked="True" Margin="0,0,0,10" Foreground="#DBE3E3"/>
      <RadioButton x:Name="FixedSource" Content="{DynamicResource objectFixedSource}" GroupName="PropSource" Margin="0,0,0,10" Foreground="#DBE3E3"/>
      <TextBlock x:Name="SourceName" Text="{DynamicResource buildingSourceAny}" TextWrapping="Wrap" Foreground="#E8B778" Margin="0,0,0,12"/>
      <TextBlock Text="{DynamicResource objectSourceHint}" Style="{StaticResource BuildHint}"/>
      <Button ContentTemplate="{StaticResource BuildWrappedText}" x:Name="UseSelectedSource" Content="{DynamicResource objectUseSelectedSource}" Margin="0,0,0,8"/>
      <Button ContentTemplate="{StaticResource BuildWrappedText}" x:Name="CaptureSource" Content="{DynamicResource objectCaptureSource}"/>
     </StackPanel></Border>
     <Border Style="{StaticResource BuildPanel}"><StackPanel>
      <TextBlock Text="{DynamicResource nearbyTitle}" Style="{StaticResource BuildHeading}"/>
      <TextBlock Text="{DynamicResource nearbyHint}" Style="{StaticResource BuildHint}"/>
      <DockPanel Margin="0,0,0,12"><Button x:Name="ScanNearby" Content="{DynamicResource nearbyScan}" ContentTemplate="{StaticResource BuildWrappedText}"/><TextBlock Text="{DynamicResource nearbyRadiusLabel}" VerticalAlignment="Center" Margin="12,0,6,0"/><TextBox x:Name="NearbyRadius" Text="10" Width="72" Margin="0,4,0,4"/></DockPanel>
      <TextBlock x:Name="NearbyCount" Text="{DynamicResource nearbyEmpty}" Foreground="#91A2A8" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <ListBox x:Name="NearbyList" Height="220" Margin="0,0,0,12"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/></DataTemplate></ListBox.ItemTemplate></ListBox>
      <Button x:Name="UseNearby" Content="{DynamicResource nearbyUse}" ContentTemplate="{StaticResource BuildWrappedText}"/>
     </StackPanel></Border>
    </StackPanel>
    <Border Style="{StaticResource BuildPanel}" Margin="8,0,0,14"><StackPanel>
     <TextBlock Text="{DynamicResource objectCatalogTitle}" Style="{StaticResource BuildHeading}"/>
     <Button x:Name="ImportGameCatalog" Content="{DynamicResource objectImport}" ContentTemplate="{StaticResource BuildWrappedText}" Margin="0,0,0,10"/>
     <TextBlock x:Name="CatalogSource" TextWrapping="Wrap" Style="{StaticResource BuildHint}"/>
     <TextBlock Text="{DynamicResource objectSearchHint}" Foreground="#91A2A8"/>
     <TextBox x:Name="ObjectSearch"/>
     <ToggleButton x:Name="ObjectFavoritesOnly" Content="{DynamicResource objectOnlyFavorites}" Style="{DynamicResource FavoriteFilter}" HorizontalAlignment="Left" Margin="0,0,0,10"/>
     <CheckBox x:Name="TechnicalObjects" Content="{DynamicResource objectTechnical}" Margin="0,0,0,10"/>
     <TextBlock x:Name="ObjectCount" TextWrapping="Wrap" Foreground="#91A2A8" Margin="0,0,0,8"/>
     <ListBox x:Name="ObjectList" Height="330" Margin="0,0,0,12"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/></DataTemplate></ListBox.ItemTemplate></ListBox>
     <Button ContentTemplate="{StaticResource BuildWrappedText}" x:Name="UseSelectedObject" Content="{DynamicResource objectUseSelected}" Margin="0,0,0,8"/>
     <Button ContentTemplate="{StaticResource BuildWrappedText}" x:Name="ToggleObjectFavorite" Content="{DynamicResource objectFavorite}"/>
    </StackPanel></Border>
   </UniformGrid>
   <TextBlock x:Name="ObjectStatus" Foreground="#E8B778" TextWrapping="Wrap" Margin="0,4,0,12"/>
  </StackPanel>
  <StackPanel x:Name="EquipmentPage" Margin="0,0,10,0" Visibility="Collapsed">
   <TextBlock Text="{DynamicResource equipmentTitle}" FontFamily="Georgia" FontSize="28" Margin="0,0,0,8"/>
   <TextBlock Text="{DynamicResource equipmentIntro}" Style="{StaticResource BuildHint}"/>
   <Button x:Name="EquipmentConnect" Content="{DynamicResource buildingConnect}" HorizontalAlignment="Left" Margin="0,0,0,14"/>
   <Border Style="{StaticResource BuildPanel}"><StackPanel>
    <DockPanel Margin="0,0,0,8"><ToggleButton x:Name="DurabilityFavorite" Style="{DynamicResource Star}" DockPanel.Dock="Right" ToolTip="{DynamicResource craftFavorite}"/><TextBlock Text="{DynamicResource durabilityTitle}" Style="{StaticResource BuildHeading}" VerticalAlignment="Center"/></DockPanel>
    <TextBlock Text="{DynamicResource durabilityHint}" Style="{StaticResource BuildHint}"/>
    <DockPanel><TextBlock x:Name="DurabilityState" Text="{DynamicResource durabilityOff}" Foreground="#91A2A8" VerticalAlignment="Center"/><ToggleButton x:Name="DurabilityToggle" Style="{DynamicResource Toggle}" HorizontalAlignment="Right"/></DockPanel>
   </StackPanel></Border>
<Border Style="{StaticResource BuildPanel}"><StackPanel><TextBlock Text="{DynamicResource StackTitle}" Style="{StaticResource BuildHeading}"/><TextBlock Text="{DynamicResource StackHint}" Style="{StaticResource BuildHint}"/><TextBlock Text="{DynamicResource StackSlotLabel}" Style="{StaticResource BuildHint}"/><ComboBox x:Name="StackSlot" Width="240" HorizontalAlignment="Left" Margin="0,0,0,14"/><TextBlock x:Name="StackValues" Foreground="#EDE5D7" TextWrapping="Wrap" Margin="0,0,0,14"/><TextBox x:Name="StackAmount" Text="5000" Background="#0F191E" Foreground="#EDE5D7" BorderBrush="#34434A" Padding="12,8" Margin="0,0,0,10"/><Button x:Name="StackApply" Content="{DynamicResource StackAction}" IsEnabled="False"/><TextBlock Text="{DynamicResource StackRefreshHint}" Style="{StaticResource BuildHint}" Margin="0,10,0,0"/><TextBlock x:Name="StackStatus" TextWrapping="Wrap" Foreground="#E8B778" Margin="0,10,0,0"/></StackPanel></Border>
<Border Style="{StaticResource BuildPanel}"><StackPanel><TextBlock Text="{DynamicResource StackLimitTitle}" Style="{StaticResource BuildHeading}"/><TextBlock Text="{DynamicResource StackLimitHint}" Style="{StaticResource BuildHint}"/><TextBlock x:Name="StackLimitValues" TextWrapping="Wrap" Margin="0,0,0,14"/><TextBox x:Name="StackLimitAmount" Text="50000" Background="#0F191E" Foreground="#EDE5D7" BorderBrush="#34434A" Padding="12,8" Margin="0,0,0,10"/><Button x:Name="StackLimitApply" Content="{DynamicResource StackLimitAction}" IsEnabled="False"/><Button x:Name="StackLimitReset" Content="{DynamicResource StackLimitReset}" Margin="0,10,0,0" IsEnabled="False"/><TextBlock x:Name="StackLimitStatus" TextWrapping="Wrap" Foreground="#E8B778" Margin="0,10,0,0"/></StackPanel></Border>
   <TextBlock x:Name="EquipmentStatus" Foreground="#E8B778" TextWrapping="Wrap" Margin="0,4,0,12"/>
  </StackPanel>
  <StackPanel x:Name="CraftPage" Margin="0,0,10,0" Visibility="Collapsed">
   <TextBlock Text="{DynamicResource craftTitle}" FontFamily="Georgia" FontSize="28" Margin="0,0,0,8"/>
   <TextBlock Text="{DynamicResource craftIntro}" Style="{StaticResource BuildHint}"/>
   <Button ContentTemplate="{StaticResource BuildWrappedText}" x:Name="CraftConnect" Content="{DynamicResource buildingConnect}" HorizontalAlignment="Left" Margin="0,0,0,14"/>
   <Border Style="{StaticResource BuildPanel}"><StackPanel>
    <DockPanel Margin="0,0,0,8"><ToggleButton x:Name="CraftFavorite" Style="{DynamicResource Star}" DockPanel.Dock="Right" ToolTip="{DynamicResource craftFavorite}"/><TextBlock Text="{DynamicResource craftPreserveTitle}" Style="{StaticResource BuildHeading}" VerticalAlignment="Center"/></DockPanel>
    <TextBlock Text="{DynamicResource craftPreserveHint}" Style="{StaticResource BuildHint}"/>
    <DockPanel><TextBlock x:Name="CraftState" Text="{DynamicResource craftPreserveOff}" Foreground="#91A2A8" VerticalAlignment="Center"/><ToggleButton x:Name="CraftToggle" Style="{DynamicResource Toggle}" HorizontalAlignment="Right"/></DockPanel>
   </StackPanel></Border>
   <Border Style="{StaticResource BuildPanel}"><StackPanel>
    <TextBlock Text="{DynamicResource craftNextTitle}" Style="{StaticResource BuildHeading}"/>
    <TextBlock Text="{DynamicResource craftNextHint}" Style="{StaticResource BuildHint}"/>
   </StackPanel></Border>
   <TextBlock x:Name="CraftStatus" Foreground="#E8B778" TextWrapping="Wrap" Margin="0,4,0,12"/>
  </StackPanel>
 </Grid>
</UserControl>
