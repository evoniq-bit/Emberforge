      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource languageIdea}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource languageIdeaDescription}" Foreground="#91A2A8" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
